{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [],
  "categories": {
    "correctness": "off"
  },
  "options": {
    "reportUnusedDisableDirectives": "warn"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    "**/lib/**",
    "**/node_modules/**",
    "**/.sessions/**",
    "**/*.config.ts",
    "tsdown.client.ts"
  ],
  "overrides": [
    {
      // The narrowed repository profile: the eight packages this fork owns, with
      // syntax rules only. Type-aware and jsPlugin rule sets moved out with the
      // harness copy they were calibrated against.
      "files": [
        "packages/*/*/src/**/*.{ts,tsx}",
        "packages/*/*/tests/**/*.{ts,tsx}"
      ],
      "rules": {
        "no-var": "error",
        "prefer-const": "error",
        "prefer-rest-params": "error",
        "prefer-spread": "error",
        "no-array-constructor": "error",
        "no-unused-expressions": "error",
        "no-unused-vars": [
          "error",
          {
            "argsIgnorePattern": "^_",
            "varsIgnorePattern": "^_",
            "caughtErrorsIgnorePattern": "^_"
          }
        ],
        "no-useless-constructor": "error",
        "no-restricted-properties": [
          "error",
          {
            "object": "crypto",
            "property": "randomUUID",
            "message": "browsers withhold crypto.randomUUID outside secure contexts (plain-HTTP LAN pages); mint through @deepseek-ai/dsh-util-crypto instead"
          }
        ]
      }
    }
  ]
}
