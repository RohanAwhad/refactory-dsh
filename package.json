{
  "name": "refactory-dsh",
  "version": "0.1.5-rc.3",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.5-rc.3"
  },
  "pnpm": {
    "overrides": {
      "@deepseek-ai/cordis": "4.0.2",
      "cordis-plugin-loader": "1.0.3",
      "cordis-plugin-include": "1.0.7",
      "cordis-plugin-hmr": "1.0.17",
      "cordis-plugin-timer": "1.1.4",
      "cordis-plugin-group": "1.0.2",
      "@deepseek-ai/schemastery": "3.18.2"
    }
  },
  "scripts": {
    "build": "pnpm run typecheck && tsdown --env.DSH_BUILD_FACE host && tsdown --env.DSH_BUILD_FACE client",
    "typecheck": "tsc -b tsconfig.host.json && tsc -b tsconfig.client.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:gui": "vitest run packages/client",
    "lint": "oxlint packages"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-typert-generator": "0.1.5-rc.3",
    "@shikijs/langs": "^4.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@vitest/coverage-v8": "^4.1.8",
    "anser": "^2.3.5",
    "immer": "^10.1.1",
    "jsdom": "29.1.1",
    "katex": "^0.16.47",
    "lefthook": "^2.1.9",
    "lightningcss": "^1.32.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.0.1",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "oxlint": "1.76.0",
    "shiki": "^4.3.1",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8",
    "zustand": "~4.4.7"
  },
  "optionalDependencies": {
    "@deepseek-ai/dsh-subagent-codex": "0.1.5-rc.3",
    "@deepseek-ai/dsh-subagent-claude-code": "0.1.5-rc.3"
  }
}
