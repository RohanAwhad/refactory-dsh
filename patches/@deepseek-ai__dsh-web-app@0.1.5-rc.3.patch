diff --git a/cordis.patch.yml b/cordis.patch.yml
--- a/cordis.patch.yml
+++ b/cordis.patch.yml
@@ -1,3 +1,9 @@
+# Advancing a stateful workflow uses identical arguments by design. Keep the
+# reminder for other tools; argument repetition is not workflow progress evidence.
+- id: repeat-tool-reminder
+  config:
+    exclude: [wf_next]
+
 # The dsh-web-app bundle patch: the browser surface over the dsh-base layer.
 # Applied after dsh-base's insert; rows here override base rows by id, with
 # the profile's own cordis.patch.yml and any --patch overlays still to come.
@@ -105,6 +111,20 @@
     - id: session-controller
       name: '@deepseek-ai/dsh-api-session-controller'
 
+    # The refactory console over Typert Remote: the same process boundary the
+    # model-facing tool uses, so the Web picker and the model read one JSON.
+    # `repoRoot` is the checkout holding `refactory/` and `.venv/`, which is the
+    # launcher's working directory.
+    - id: refactory-console
+      name: '@deepseek-ai/dsh-refactory-console'
+      config:
+        repoRoot: !!js process.cwd()
+
+    # The interactive workflow spine is NOT mounted here. It lives in the `ceo`
+    # preset's `agent.cordis.yml` so the CEO it guards is in the mount's scope:
+    # a host row has no scope, and the spine's deny-guard needs one to restrict
+    # the CEO's own tools. See the patch on `@deepseek-ai/dsh-agent-presets`.
+
     # Workspace file service: bounded read, directory listing, and the
     # agent-write change feed inside the session workspace root.
     - id: workspace-files
@@ -234,6 +254,11 @@
     - id: ui-sidebar-files
       name: '@deepseek-ai/dsh-client-ui-sidebar-files'
 
+    # The right Sidebar's refactory picker: the console's described choices,
+    # started and read through the refactoryConsole endpoint.
+    - id: ui-refactory
+      name: '@deepseek-ai/dsh-client-ui-refactory'
+
     - id: ui-settings
       name: '@deepseek-ai/dsh-client-ui-settings'
 
@@ -255,9 +280,14 @@
     - id: ui-chat
       name: '@deepseek-ai/dsh-client-ui-chat'
 
-    # Official occupants for the generic sidebar and conversation brand slots.
+    # Disabled: the re:factory brand replaces the DeepSeek whale.
     - id: ui-brand-official
       name: '@deepseek-ai/dsh-client-ui-brand-official'
+      disabled: true
+
+    # re:factory occupants for the generic brand slots.
+    - id: ui-brand-refactory
+      name: '@deepseek-ai/dsh-client-ui-brand-refactory'
 
     - id: ui-attachment
       name: '@deepseek-ai/dsh-client-ui-attachment'
@@ -481,4 +511,4 @@
     - id: agent-presets
       name: '@deepseek-ai/dsh-agent-presets'
       config:
-        default: standard
+        default: ceo
