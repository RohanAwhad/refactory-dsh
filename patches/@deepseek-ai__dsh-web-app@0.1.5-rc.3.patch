diff --git a/cordis.patch.yml b/cordis.patch.yml
index cf4603031f6f452891a4d7da420869b6472fb333..8e524d7f6f3e7463c0347fb2a11df38be47586fb 100644
--- a/cordis.patch.yml
+++ b/cordis.patch.yml
@@ -105,6 +105,48 @@
     - id: session-controller
       name: '@deepseek-ai/dsh-api-session-controller'
 
+    # The refactory console over Typert Remote: the same process boundary the
+    # model-facing tool uses, so the Web picker and the model read one JSON.
+    # `repoRoot` is the checkout holding `refactory/` and `.venv/`, which is the
+    # launcher's working directory.
+    - id: refactory-console
+      name: '@deepseek-ai/dsh-refactory-console'
+      config:
+        repoRoot: !!js process.cwd()
+
+    # The interactive workflow spine: the CEO drives an opened mode's graph node
+    # by node in the chat. It mounts with no graph -- `interactiveOpen` means a
+    # session lowers a mode at run time through `wf_open` -- so the graph, the
+    # work directory and the node environment all arrive per run in that open
+    # payload. Only the commands and the fallbacks are composition state, and
+    # `process.cwd()` is the launcher's directory, the checkout holding `.venv/`.
+    # The runner resolves `shell` from this host composition; no code-runtime row
+    # is needed for it.
+    - id: workflow-spine
+      name: '@deepseek-ai/dsh-workflow-spine'
+      config:
+        interactiveOpen: true
+        toolPrefix: wf
+        maxIterations: 500
+        executeCommands: true
+        openCommand: !!js process.cwd() + '/.venv/bin/python'
+        openArgs: ['-m', 'refactory_dsh.console', 'open']
+        steerCommand: !!js process.cwd() + '/.venv/bin/python'
+        steerArgs: ['-m', 'refactory_dsh.console', 'steer', '--run']
+        commandTimeoutMs: 3600000
+        ceoDeny:
+          - bash
+          - pwsh
+          - write
+          - edit
+          - str_replace_editor
+          - web_search
+          - web_fetch
+          - skill
+          - ralph
+          - workflow
+          - read_image
+
     # Workspace file service: bounded read, directory listing, and the
     # agent-write change feed inside the session workspace root.
     - id: workspace-files
@@ -234,6 +276,11 @@
     - id: ui-sidebar-files
       name: '@deepseek-ai/dsh-client-ui-sidebar-files'
 
+    # The right Sidebar's refactory picker: the console's described choices,
+    # started and read through the refactoryConsole endpoint.
+    - id: ui-refactory
+      name: '@deepseek-ai/dsh-client-ui-refactory'
+
     - id: ui-settings
       name: '@deepseek-ai/dsh-client-ui-settings'
 
@@ -255,9 +302,14 @@
     - id: ui-chat
       name: '@deepseek-ai/dsh-client-ui-chat'
 
-    # Official occupants for the generic sidebar and conversation brand slots.
+    # Disabled: the re:factory brand replaces the DeepSeek whale.
     - id: ui-brand-official
       name: '@deepseek-ai/dsh-client-ui-brand-official'
+      disabled: true
+
+    # re:factory occupants for the generic brand slots.
+    - id: ui-brand-refactory
+      name: '@deepseek-ai/dsh-client-ui-brand-refactory'
 
     - id: ui-attachment
       name: '@deepseek-ai/dsh-client-ui-attachment'
@@ -481,4 +533,4 @@
     - id: agent-presets
       name: '@deepseek-ai/dsh-agent-presets'
       config:
-        default: standard
+        default: ceo
