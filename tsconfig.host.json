{
  // Host aggregate (one of the two check units; see tsconfig.json). The two
  // packages under packages/client type-check in tsconfig.client.json: the two
  // sides merge cordis Context under the same keys, so one program cannot see
  // both. The typert generator finds the workspace root by walking up to this
  // file, so it stays at the repository root.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rewriteRelativeImportExtensions": false
  },
  "include": [
    "packages/workflow/workflow-spine/tests/**/*.ts",
    "packages/bundle/graph/tests/**/*.ts",
    "packages/bundle/refactory-presets/tests/**/*.ts",
    "packages/refactory/refactory-console/tests/**/*.ts",
    "packages/refactory/tool-refactory/tests/**/*.ts"
  ],
  "references": [
    { "path": "./packages/workflow/workflow-spine" },
    { "path": "./packages/bundle/graph" },
    { "path": "./packages/bundle/refactory-presets" },
    { "path": "./packages/refactory/refactory-console" },
    { "path": "./packages/refactory/tool-refactory" }
  ]
}
