{
  // Client-side typecheck aggregate: the browser half of the two packages under
  // packages/client. Split from the host aggregate because both sides merge
  // cordis Context under the same keys with different services; one program
  // cannot see both.
  "extends": "./tsconfig.base.client.json",
  "compilerOptions": {
    "noEmit": true,
    "rewriteRelativeImportExtensions": false,
    // Tests execute under vitest on node (jsdom for the per-file pragma).
    "types": ["node"]
  },
  "include": [
    // Source-subpath test imports can arrive through workspace links whose
    // realpath semantics vary by host. Load package CSS declarations directly.
    "packages/client/*/src/css-modules.d.ts",
    "packages/client/*/tests/**/*.ts",
    "packages/client/*/tests/**/*.tsx"
  ],
  "references": [
    { "path": "./packages/client/ui-refactory" },
    { "path": "./packages/client/ui-brand-refactory" }
  ]
}
