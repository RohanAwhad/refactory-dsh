#!/usr/bin/env bash
# refactory-dsh — launch DSH with the refactory tooling.
#
# Starts the DSH web GUI from the pinned harness the root manifest declares. The
# glue lives at `refactory/`; the harness is the published `@deepseek-ai/dsh`
# install under `node_modules`, so this script only resolves that launcher.
#
# The graph profile the Python glue runs modes on is machine state, created by
# `./install.sh` (or by `pnpm exec dsh plugin --profile graph add
# packages/bundle/graph`). The web profile is the pinned harness's own.
#
# The meta-modes are Python entry points, not presets:
#   python -m refactory_dsh.create   create a mode
#   python -m refactory_dsh.edit     revise a mode from a brief
#   python -m refactory_dsh.design   design software
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DSH_ROOT="${DSH_ROOT:-$HERE}"

# Node 22 is required; prefer the nvm version when present, else trust PATH.
if [ -x "$HOME/.nvm/versions/node/v22.23.2/bin/node" ]; then
  export PATH="$HOME/.nvm/versions/node/v22.23.2/bin:$PATH"
fi

DSH="$DSH_ROOT/node_modules/.bin/dsh"
if [ ! -x "$DSH" ]; then
  echo "refactory-dsh: no dsh launcher at $DSH" >&2
  echo "               run ./install.sh (or: pnpm install) first." >&2
  exit 1
fi

cd "$DSH_ROOT"
exec "$DSH" --profile web "$@"
