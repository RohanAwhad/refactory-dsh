#!/usr/bin/env bash
# refactory-dsh — launch DSH with the refactory tooling.
#
# Starts the DSH web GUI from the pinned harness the root manifest declares. The
# glue lives at `refactory/`; the harness is the published `@deepseek-ai/dsh`
# install under `node_modules`, so this script only resolves that launcher.
#
# The checkout-owned bundles are **machine state**: a DSH profile is created by
# `dsh plugin --profile <name> add <package>`, never derived from the bundle's
# name. `./install.sh` creates them, and this script heals a missing one rather
# than booting into the failure it causes. The GUI profile is `refactory`, a
# re:factory-owned profile over the harness's `web` template; the harness's own
# `web` profile is never written to. Without `refactory` the profile has
# no `ceo` preset while the composition still names `ceo` as the roster default,
# so every session created without naming one stops with `agent-preset/not-found`;
# without `refactory-web` the console and picker rows never mount.
#
# --additive creates and launches refactory-web, derived from the existing web
# profile (or --profile NAME). It keeps every preset, default and branding,
# adds CEO and the Modes panel, and reuses the derived profile on later launches.
#
# The graph profile is what the Python glue runs modes on.
#
# The meta-modes are Python entry points, not presets:
#   python -m refactory_dsh.create   create a mode
#   python -m refactory_dsh.edit     revise a mode from a brief
#   python -m refactory_dsh.design   design software
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DSH_ROOT="${DSH_ROOT:-$HERE}"

ADDITIVE=0
PROFILE=""
FORWARDED=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --additive) ADDITIVE=1; shift ;;
    --help|-h)
      cat <<'HELP'
Usage: ./refactory-dsh [--additive] [--profile NAME] [DSH options]

Default: launch the standalone Refactory GUI with CEO and Minimal.
--additive: create and launch refactory-web, derived from web, with all presets
            plus CEO and the Modes panel. Later launches reuse refactory-web.
--profile NAME: source profile for additive mode (default: web); otherwise the
                standalone profile to launch (default: refactory).

Other DSH options, such as --port and --no-open, pass through unchanged.
HELP
      exit 0 ;;
    --profile)
      if [ "$#" -lt 2 ] || [ -z "$2" ] || [[ "$2" == --* ]]; then
        echo "refactory-dsh: --profile requires a profile name" >&2
        exit 2
      fi
      PROFILE="$2"; shift 2 ;;
    --profile=*)
      PROFILE="${1#--profile=}"
      if [ -z "$PROFILE" ]; then
        echo "refactory-dsh: --profile requires a profile name" >&2
        exit 2
      fi
      shift ;;
    --) FORWARDED+=("$@"); break ;;
    *) FORWARDED+=("$1"); shift ;;
  esac
done
if [ "$ADDITIVE" -eq 0 ]; then
  PROFILE="${PROFILE:-refactory}"
fi

# Node 22 is required; prefer the nvm version when present, else trust PATH.
if [ -x "$HOME/.nvm/versions/node/v22.23.2/bin/node" ]; then
  export PATH="$HOME/.nvm/versions/node/v22.23.2/bin:$PATH"
fi

DSH="$DSH_ROOT/node_modules/.bin/dsh"
if [ ! -x "$DSH" ]; then
  echo "refactory-dsh: no dsh launcher at $DSH" >&2
  echo "               run ./install.sh (or: pnpm install) first." >&2
  exit 1
fi

# One template init (for an owned profile with no directory yet) and one
# `dsh plugin add` per layer that is not installed. The plan is `dsh_profile`'s,
# so this script cannot drift from the check `refactory doctor` and the runner
# make; the loop only runs when there is a gap, so a provisioned machine boots
# without invoking pnpm at all.
#
# A missing interpreter is NOT treated as "nothing missing": failing open here
# would boot the GUI into the failures this block exists to prevent, so it is a
# hard error naming the fix instead.
PYTHON="$DSH_ROOT/.venv/bin/python"
if [ ! -x "$PYTHON" ]; then
  echo "refactory-dsh: no interpreter at $PYTHON, so the DSH profiles cannot be checked." >&2
  echo "               run ./install.sh first (it creates .venv and both profiles)." >&2
  exit 1
fi

PLAN="$(REFACTORY_ADDITIVE="$ADDITIVE" "$PYTHON" -c '
from refactory_dsh import dsh_profile
import os
steps = dsh_profile.provision_plan()
if os.environ.get("REFACTORY_ADDITIVE") == "1":
    steps = [step for step in steps if step.profile == dsh_profile.GRAPH_PROFILE]
print(dsh_profile.render_plan(steps), end="")
')"
if [ -n "$PLAN" ]; then
  echo "refactory-dsh: provisioning owned DSH profiles" >&2
  # `value` is the template for `init`, a directory under `packages/bundle/` for
  # `add`, and one or more space-separated package names for `remove` and `clean`
  # -- only the add branch prefixes the checkout bundle root.
  # The names are split rather than passed as one argument: `pnpm remove`
  # takes them as a list and removes nothing at all when one of them is not a
  # declared dependency, so one profile's retirements travel in a single call.
  while IFS=$'\t' read -r kind profile value; do
    [ -n "$kind" ] || continue
    case "$kind" in
      init)   "$DSH" --profile "$profile" --from-default-profile "$value" --dump-config >/dev/null ;;
      add)    "$DSH" plugin --profile "$profile" add "$DSH_ROOT/packages/bundle/$value" ;;
      remove)
        read -r -a retired <<<"$value"
        "$DSH" plugin --profile "$profile" remove "${retired[@]}"
        ;;
      clean)
        # Runs before the plugin rows for its profile, and takes the
        # profile's own writer lock: the plugin rows acquire that same lock, so
        # holding it across them would deadlock.
        "$PYTHON" -c 'import sys; from refactory_dsh import dsh_profile; dsh_profile.clean_manifest(sys.argv[1])' "$profile"
        ;;
    esac
  done <<<"$PLAN"
fi

cd "$DSH_ROOT"
if [ "$ADDITIVE" -eq 1 ]; then
  PROFILE="$(node "$HERE/refactory/refactory_dsh/additive.mjs" "$DSH_ROOT" "$PROFILE")"
  exec "$DSH" --profile "$PROFILE" "${FORWARDED[@]}"
fi
exec "$DSH" --profile "$PROFILE" "${FORWARDED[@]}"
