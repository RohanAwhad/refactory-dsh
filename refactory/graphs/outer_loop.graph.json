{
  "name": "outer-loop",
  "nodes": {
    "init": {
      "id": "init",
      "_type": "FnNode",
      "blocking": true,
      "reads": [],
      "writes": [
        ".factory/outer_loop/config.json",
        ".factory/outer_loop/population/",
        ".factory/outer_loop/archive/",
        ".factory/outer_loop/state.json"
      ],
      "command": "python -m refactory_dsh.ops.outer_loop init",
      "notes": "Initialise the parameters: build the starting population."
    },
    "forward": {
      "id": "forward",
      "_type": "FnNode",
      "blocking": true,
      "reads": [
        ".factory/outer_loop/population/"
      ],
      "writes": [
        ".factory/outer_loop/population/",
        ".factory/outer_loop/graph_state.json",
        ".factory/outer_loop/traces/"
      ],
      "command": "python -m refactory_dsh.ops.outer_loop forward",
      "notes": "Run the mode once per candidate in the mini-batch."
    },
    "loss": {
      "id": "loss",
      "_type": "FnNode",
      "blocking": true,
      "reads": [
        ".factory/outer_loop/traces/"
      ],
      "writes": [
        ".factory/outer_loop/loss.json"
      ],
      "command": "python -m refactory_dsh.ops.outer_loop loss",
      "notes": "Turn the batch's runs into a number."
    },
    "backward": {
      "id": "backward",
      "_type": "FnNode",
      "blocking": true,
      "reads": [
        ".factory/outer_loop/population/",
        ".factory/outer_loop/loss.json"
      ],
      "writes": [
        ".factory/outer_loop/proposal-request.md",
        ".factory/outer_loop/gradient.json"
      ],
      "command": "python -m refactory_dsh.ops.outer_loop backward",
      "notes": "Compute the gradient from the traces and write the request."
    },
    "optimizer": {
      "id": "optimizer",
      "_type": "AgentNode",
      "blocking": true,
      "role": "ceo",
      "reads": [
        ".factory/outer_loop/proposal-request.md",
        ".factory/outer_loop/gradient.json"
      ],
      "writes": [
        ".factory/outer_loop/proposals.json"
      ],
      "prompt_template": "You are the optimizer. You decide the next update to the mode's parameters.\n\n1. Read `.factory/outer_loop/proposal-request.md`. It carries the recent candidates\n   with links to their full trace summaries, the gradient, and the parameters you\n   may move (each with its kind, bounds and whether it is expandable).\n2. Read any trace summary you need for detail. Do not guess at numbers you can read.\n3. Write `.factory/outer_loop/proposals.json`:\n\n{\"diagnosis\": \"<what the evidence shows is limiting the loss>\",\n \"proposals\": [{\"knob\": \"<parameter>\", \"value\": \"<new value>\",\n                \"rationale\": \"<why, citing the evidence>\",\n                \"prediction\": \"<expected effect on the loss>\", \"confidence\": 0.0}]}\n\nRules:\n- Few well-argued changes, not many guesses. Vary which parameter you move.\n- A `topology` parameter takes the name of a structural operation, not a number.\n- If a parameter is saturated, push it past its bounds only when it is expandable.\n- Your prediction is recorded and later checked against the outcome, so state what\n  you expect and how you could be wrong.\n- If the evidence justifies no change, write a diagnosis and an empty proposal list\n  rather than guessing."
    },
    "step": {
      "id": "step",
      "_type": "FnNode",
      "blocking": true,
      "reads": [
        ".factory/outer_loop/proposals.json"
      ],
      "writes": [
        ".factory/outer_loop/population/",
        ".factory/outer_loop/graph_state.json"
      ],
      "command": "python -m refactory_dsh.ops.outer_loop step",
      "notes": "Apply the update: validate the proposals, then evaluate them."
    },
    "scheduler": {
      "id": "scheduler",
      "_type": "GateNode",
      "blocking": true,
      "reads": [
        ".factory/outer_loop/state.json",
        ".factory/outer_loop/graph_state.json"
      ],
      "writes": [],
      "evaluator_type": "fn",
      "evaluator_command": "python -m refactory_dsh.ops.outer_loop scheduler",
      "max_iterations": 500
    },
    "report": {
      "id": "report",
      "_type": "FnNode",
      "blocking": true,
      "reads": [
        ".factory/outer_loop/archive/"
      ],
      "writes": [
        ".factory/outer_loop/report.md"
      ],
      "command": "python -m refactory_dsh.ops.outer_loop report",
      "notes": "The visibility surface."
    }
  },
  "edges": [
    {
      "source": "init",
      "target": "forward",
      "condition": null
    },
    {
      "source": "forward",
      "target": "loss",
      "condition": null
    },
    {
      "source": "loss",
      "target": "backward",
      "condition": null
    },
    {
      "source": "backward",
      "target": "optimizer",
      "condition": null
    },
    {
      "source": "optimizer",
      "target": "step",
      "condition": null
    },
    {
      "source": "step",
      "target": "scheduler",
      "condition": null
    },
    {
      "source": "scheduler",
      "target": "forward",
      "condition": "reloop"
    },
    {
      "source": "scheduler",
      "target": "report",
      "condition": "proceed"
    }
  ],
  "start_node": "init",
  "terminal": true
}