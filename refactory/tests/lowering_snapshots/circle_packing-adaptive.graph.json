      "description": "whether the largest or the smallest circles are placed first",
      "required": false
    },
    "selector": {
      "default": "best",
      "kind": "enum",
      "lo": null,
      "hi": null,
      "enum": [
        "best",
        "tournament",
        "uniform"
      ],
      "values": [],
      "frozen": false,
      "description": "how the parent for the next candidate is chosen",
      "required": false
    },
    "acceptance_mode": {
      "default": "strict",
      "kind": "enum",
      "lo": null,
