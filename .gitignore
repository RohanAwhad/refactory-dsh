.env
node_modules/
lib/
# A vendored dependency ships its built lib/ (see vendor/node-addon-system/README.md).
!vendor/*/lib/
*.tsbuildinfo
pnpm-debug.log
.pnpm-store/
.cache/
.sessions/
coverage/
tmp/
.vscode/
.DS_Store
.idea
mise.toml
.artifacts/
.dsh-build/
.playwright-mcp/
.orig
.worktrees/
worktrees/
.typert-*/

# refactory-dsh (Python glue)
.venv/
refactory/**/__pycache__/
packages/**/__pycache__/

# Run artifacts: per-mode outer/inner-loop state, traces and reports.
refactory/workdirs/

# Where generated packages and a project's run state land. A run writes here, so it
# must not be a reason the checkout is dirty.
.factory/
# A run's node work belongs inside its work directory. The CEO's subagents are the
# one place a relative path could land in the checkout instead, so the directory they
# would create is ignored rather than committed by accident.
/reviews/
refactory/**/*.egg-info/
refactory/**/*.pyc
/.pytest_cache/
# The root project owns the lock. A stray one appears when uv runs inside refactory/.
/refactory/uv.lock
