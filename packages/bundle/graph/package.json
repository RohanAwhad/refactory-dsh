{
  "name": "@deepseek-ai/dsh-graph",
  "description": "The dsh graph bundle: drives one CEO Agent over a refactory mode graph, for the outer loop and for a person using a mode",
  "version": "0.1.5-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/graph"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./answerer": {
      "types": "./lib/types/answerer.d.ts",
      "default": "./lib/types/answerer.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/startup.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.js"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-brand": "0.1.5-rc.3",
    "@deepseek-ai/dsh-cmdline": "0.1.5-rc.3",
    "@deepseek-ai/dsh-code-runtime-worker-thread": "0.1.5-rc.3",
    "@deepseek-ai/dsh-workflow-spine": "0.1.5-rc.3",
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.3",
    "@deepseek-ai/dsh-agent-default-model": "0.1.5-rc.3",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.3",
    "@deepseek-ai/dsh-session": "0.1.5-rc.3",
    "@deepseek-ai/dsh-user-questions": "0.1.5-rc.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.3",
    "@deepseek-ai/dsh-agent-default-model": "0.1.5-rc.3",
    "@deepseek-ai/dsh-agent-loop": "0.1.5-rc.3",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.1.5-rc.3",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.3",
    "@deepseek-ai/dsh-session": "0.1.5-rc.3",
    "@deepseek-ai/dsh-user-questions": "0.1.5-rc.3",
    "@deepseek-ai/dsh-workflow-spine": "0.1.5-rc.3"
  }
}
