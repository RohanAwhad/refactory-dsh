{
  "name": "@deepseek-ai/dsh-refactory-presets",
  "description": "The refactory agent-preset bundle: ships the `ceo` preset from this package's own `presets/` tree through the roster's configured roots",
  "version": "0.1.5-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/refactory-presets"
  },
  "type": "module",
  "exports": {
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/startup.js",
    "cordis.patch.yml",
    "presets/**/*",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2"
  }
}
