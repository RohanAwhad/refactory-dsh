{
  "name": "@deepseek-ai/dsh-refactory-presets",
  "description": "The refactory agent-preset bundle: declares the `ceo` preset inline and makes it the profile's default",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/refactory-presets"
  },
  "type": "module",
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./presets/*.patch.yml": "./presets/*.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "presets/ceo.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/ceo.patch.yml"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4"
  }
}
