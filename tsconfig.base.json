{
  // Shared compiler settings for the eight packages this fork owns. There is no
  // `paths` map: every package name resolves through node_modules, where the
  // published @deepseek-ai/dsh pin and its dependencies live. NEVER add
  // include/files to this file: it would leak into every extending package
  // project and narrow the resolution facade's match-all scope.
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "sourceMap": true,
    "declarationMap": true,
    "composite": true,
    "incremental": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"],
    // Source-level resolution for the eight packages this fork owns, so a test
    // run and a typecheck read source rather than a previously built lib/. Every
    // other specifier — the whole published harness — falls through to
    // node_modules. This file also doubles as the resolution facade for
    // vite-tsconfig-paths: NEVER add include/files here.
    "paths": {
      "@deepseek-ai/dsh-workflow-spine": ["./packages/workflow/workflow-spine/src/index.ts"],
      "@deepseek-ai/dsh-graph": ["./packages/bundle/graph/src/index.ts"],
      "@deepseek-ai/dsh-refactory-presets/startup": ["./packages/bundle/refactory-presets/src/startup.ts"],
      "@deepseek-ai/dsh-refactory-web/startup": ["./packages/bundle/refactory-web/src/startup.ts"],
      "@deepseek-ai/dsh-refactory-console": ["./packages/refactory/refactory-console/src/index.ts"],
      "@deepseek-ai/dsh-tool-refactory": ["./packages/refactory/tool-refactory/src/index.ts"],
      "@deepseek-ai/dsh-tool-refactory/console": ["./packages/refactory/tool-refactory/src/console.ts"],
      "@deepseek-ai/dsh-client-ui-refactory": ["./packages/client/ui-refactory/src/index.ts"],
      "@deepseek-ai/dsh-client-ui-refactory/client": ["./packages/client/ui-refactory/src/client/index.ts"],
      "@deepseek-ai/dsh-client-ui-brand-refactory": ["./packages/client/ui-brand-refactory/src/index.ts"],
      "@deepseek-ai/dsh-client-ui-brand-refactory/client": ["./packages/client/ui-brand-refactory/src/client/index.ts"]
    }
  }
}
